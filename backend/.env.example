# Copie para .env (nunca versione o .env). Em produção, SEGREDO_TOKEN é obrigatório.
# NODE_ENV e PORT seguem a convenção de plataformas de hospedagem e por isso mantêm o nome original.
NODE_ENV=development
PORT=3000
ARQUIVO_BANCO=./dados/emiautoys.sqlite
SEGREDO_TOKEN=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
TTL_TOKEN_SEGUNDOS=7200
ORIGEM_CORS=http://localhost:4200
CARREGAR_CATALOGO_INICIAL=true
