{
  "name": "emiautoys-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/config/main.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 \"tests/**/*.test.js\"",
    "test:unidade": "node --test \"tests/unidade/**/*.test.js\"",
    "test:contrato": "node --test \"tests/contrato/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/**/*.test.js\"",
    "test:arquitetura": "node --test \"tests/arquitetura/**/*.test.js\"",
    "arquitetura": "depcruise src --config .dependency-cruiser.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
