{
  "name": "emiautoys-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test:aplicacao": "tsx --test \"tests/application/**/*.test.ts\"",
    "test:arquitetura": "tsx --test \"tests/arquitetura/**/*.test.ts\"",
    "typecheck:aplicacao": "tsc -p tsconfig.application.json --noEmit",
    "arquitetura": "depcruise src --config .dependency-cruiser.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "imagens": "node scripts/gerar-imagens.mjs",
    "test:componentes": "ng test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.50.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^9.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.0.0",
    "sharp": "^0.34.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
